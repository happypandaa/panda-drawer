<% var englishPage = page.lang === 'en'; %>
<footer id="footer">
  <div class="footer-left">
    <%= englishPage ? 'Copyright' : __('footer.copyright') %> &copy;
    <% var endYear = (theme.copyright && theme.copyright.end_year) ? theme.copyright.end_year : new Date().getFullYear() %>
    <% var startYear = (theme.copyright && theme.copyright.start_year) ? theme.copyright.start_year : new Date().getFullYear() %>
    <%= startYear >= endYear ? endYear : startYear + "-" + endYear %>
    <%= englishPage ? 'Panda Drawer' : config.author || config.title %>
  </div>
  <div class="footer-right">
    <nav>
      <ul>
        <% for (var i in theme.nav) { %><!--
       --><li><a href="<%- url_for((englishPage ? '/en' : '') + theme.nav[i]) %>"><%= __('nav.'+i).replace("nav.", "") %></a></li><!--
     --><% } %>
        <li><a href="<%- url_for(englishPage ? '/en/wiki/#for-ai-and-app-authors' : '/wiki/#给-AI-和应用作者') %>"><%= englishPage ? 'For AI & app authors' : '给 AI 和作者' %></a></li>
        <li><a href="https://github.com/happypandaa/panda-drawer">GitHub</a></li>
        <li><a href="https://gitee.com/mycolorfuldays/panda-drawer">Gitee</a></li>
        <li><a href="<%- url_for(alternate_language_page() || (englishPage ? '/' : '/en/')) %>" lang="<%= englishPage ? 'zh-CN' : 'en' %>" hreflang="<%= englishPage ? 'zh-CN' : 'en' %>"><%= englishPage ? '中文' : 'English' %></a></li>
        <li><a href="<%- url_for(englishPage ? '/en/licenses/' : '/licenses/') %>"><%= englishPage ? 'Third-party licenses' : '第三方许可' %></a></li>
      </ul>
    </nav>
  </div>
</footer>
