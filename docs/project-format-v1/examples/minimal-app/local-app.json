{
  "packageFormat": "local-web-app",
  "formatVersion": 1,
  "runtime": "static-web",
  "app": {
    "id": "org.example.minimal-static",
    "name": "最小静态页面示例",
    "version": "1.0.0",
    "description": "仅用于说明拟议应用包 v1 结构的静态文字页面"
  },
  "web": {
    "root": "dist",
    "entry": "index.html",
    "routing": "files"
