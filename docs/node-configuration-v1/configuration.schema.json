{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-projects:trial:node-configuration:v1",
  "title": "Node 应用配置声明 v1（实验子集）",
  "description": "只描述 local-app.json 的 configuration 对象，不是用户配置值、完整应用包格式或安装授权。",
  "$comment": "编辑辅助 Schema。最终读取以 platform-core 的 TrialManifest 为准：UTF-8 字节限制、重复 JSON 键/变量/选项值、保留变量、URL 语义、endpointField 跨字段引用、select 默认值成员关系及文件布局必须另外检查。JSON Schema 的字符计数与数学整数语义不替代 Rust 的字节和 i64 检查。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fields"],
  "properties": {
    "version": { "const": 1 },
    "fields": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/field" }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": { "pattern": "\u0000" }
    },
    "variable": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "not": {
        "anyOf": [
          { "pattern": "^(APP_|PLATFORM_|NODE_|LD_|DYLD_|VITE_|LC_)" },
          { "enum": ["PATH", "HOME", "USERPROFILE", "APPDATA", "LOCALAPPDATA", "TMP", "TEMP", "TMPDIR", "HOST", "PORT", "LANG", "USER", "LOGNAME", "SHELL", "COMSPEC", "SYSTEMROOT", "WINDIR", "BASH_ENV", "ENV", "PYTHONPATH", "PYTHONHOME"] }
        ]
      }
    },
    "https": {
      "type": "string",
      "pattern": "^[hH][tT][tT][pP][sS]://[^/?#@]+(?:/[^?#]*)?$",
      "$comment": "不使用 ASCII URI 格式断言排除合法国际化域名，不提供 URL 自动改写；Rust 还检查可解析性、host、用户名、密码、查询与片段。"
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "allOf": [{ "$ref": "#/$defs/text" }], "maxLength": 1000 },
        "label": { "allOf": [{ "$ref": "#/$defs/text" }], "maxLength": 160 }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "type", "required", "secret", "description", "howToGet"],
      "properties": {
        "name": { "$ref": "#/$defs/variable" },
        "label": { "allOf": [{ "$ref": "#/$defs/text" }], "maxLength": 160 },
        "type": { "enum": ["string", "url", "integer", "boolean", "select"] },
        "required": { "type": "boolean", "description": "启动前是否必须有有效值；有合法非秘密默认值可满足。不是某项业务功能的条件必填。" },
        "secret": { "type": "boolean", "description": "秘密字段只能为 string，禁止 default；不在清单内存放实际值。" },
        "description": { "allOf": [{ "$ref": "#/$defs/text" }], "maxLength": 4000 },
        "howToGet": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "allOf": [{ "$ref": "#/$defs/text" }], "maxLength": 2000 }
        },
        "placeholder": { "allOf": [{ "$ref": "#/$defs/text" }], "maxLength": 1000 },
        "default": { "type": ["string", "integer", "boolean"] },
        "helpUrl": { "$ref": "#/$defs/https" },
        "endpointField": { "$ref": "#/$defs/variable", "description": "仅秘密字段使用，引用同一配置中的非秘密 url 字段；最终由 Rust 交叉校验。" },
        "options": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/option" } }
      },
      "allOf": [
        {
          "if": { "properties": { "secret": { "const": true } }, "required": ["secret"] },
          "then": { "properties": { "type": { "const": "string" } }, "not": { "required": ["default"] } }
        },
        {
          "if": { "required": ["endpointField"] },
          "then": { "properties": { "secret": { "const": true } } }
        },
        {
          "if": { "properties": { "type": { "const": "select" } }, "required": ["type"] },
          "then": { "required": ["options"], "properties": { "default": { "type": "string" } } },
          "else": { "not": { "required": ["options"] } }
        },
        {
          "if": { "properties": { "type": { "const": "string" } }, "required": ["type"] },
          "then": { "properties": { "default": { "allOf": [{ "$ref": "#/$defs/text" }], "maxLength": 4000 } } }
        },
        {
          "if": { "properties": { "type": { "const": "url" } }, "required": ["type"] },
          "then": { "properties": { "default": { "$ref": "#/$defs/https" } } }
        },
        {
          "if": { "properties": { "type": { "const": "integer" } }, "required": ["type"] },
          "then": { "properties": { "default": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 } } }
        },
        {
          "if": { "properties": { "type": { "const": "boolean" } }, "required": ["type"] },
          "then": { "properties": { "default": { "type": "boolean" } } }
        }
      ]
    }
  }
}
