{
  "name": "panda-drawer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "node scripts/desktop.mjs dev",
    "build": "node scripts/desktop.mjs build",
    "build:app": "node scripts/desktop.mjs build --bundles app",
    "check": "npm run prepare:desktop && npm run build --workspace @local-projects/desktop && node scripts/rust.mjs check --locked --workspace --all-targets",
    "test": "npm run test:project-directory-names && npm run prepare:desktop && node scripts/rust.mjs test --locked --workspace",
    "rust": "node scripts/rust.mjs",
    "env:windows": "node scripts/windows-environment.mjs",
    "check:windows:toolchain": "node scripts/windows-toolchain-smoke.mjs",
    "test:process": "node --test scripts/process-test.mjs",
    "test:node-runtime": "node --test scripts/package-node-runtime-test.mjs",
    "test:local-directory-starter": "node --test scripts/local-directory-starter-test.mjs",
    "generate:project-directory-names": "node scripts/generate-project-directory-names.mjs",
    "test:project-directory-names": "node scripts/generate-project-directory-names.mjs --check",
    "test:ai-prompts": "node scripts/generate-project-ai-requirements.mjs --check",
    "test:development-node": "node --test scripts/package-development-node-test.mjs",
    "test:development-git": "node --test scripts/package-development-git-test.mjs",
    "test:platform-support": "node scripts/platform-support-test.mjs",
    "test:preflight": "node scripts/rust.mjs test --locked -p platform-preflight --lib",
    "cli": "node scripts/rust.mjs run -p platform-cli --",
    "prepare:desktop": "node scripts/prepare-desktop.mjs",
    "tauri": "node scripts/desktop.mjs",
    "test:m1:live": "node scripts/m1-live-test.mjs",
    "test:m1:restart": "node scripts/m1-restart-test.mjs",
    "test:sdk": "node --test packages/sdk/test/*.test.mjs",
    "package:sdk": "node scripts/package-sdk.mjs",
    "test:m2:live": "node scripts/m2-live-test.mjs",
    "test:runtime-notice": "node scripts/runtime-notice-test.mjs",
    "test:m4:compatibility": "node scripts/m4-compatibility-test.mjs verify",
    "test:m5:live": "node scripts/m5-live-test.mjs",
    "test:m5:restart": "node scripts/m5-restart-test.mjs",
    "test:m5:compatibility": "node scripts/m5-compatibility-test.mjs verify",
    "test:browser-tools": "node --test scripts/m5-browser-tools-test.mjs",
    "test:media-panel": "node --test scripts/m5-media-panel-test.mjs",
    "test:ui": "node --test scripts/ui-interactions-test.mjs apps/desktop/test/*.test.mjs",
    "test:desktop-package": "node --test scripts/desktop-package-output-test.mjs",
    "release:mac:preflight": "node scripts/production-macos-preflight.mjs",
    "test:production-macos-preflight": "node --test scripts/production-macos-preflight-test.mjs",
    "test:updates": "node --test scripts/update-manifest-test.mjs scripts/update-artifact-verification-test.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "jsdom": "26.1.0",
    "transliteration": "2.6.2"
  },
  "description": "熊猫小抽屉：帮助你制作、获取、使用、定制和分享个人小应用的本地应用平台。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happypandaa/panda-drawer.git"
  },
  "homepage": "https://github.com/happypandaa/panda-drawer#readme",
  "bugs": {
    "url": "https://github.com/happypandaa/panda-drawer/issues"
  }
}
